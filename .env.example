# Required — PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional — Google AdSense publisher ID (e.g. ca-pub-1234567890123456)
# Leave unset or with XXXX placeholders to show a local ad placeholder instead of real ads.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
